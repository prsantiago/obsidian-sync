{
  "name": "obsidian-gdrive-sync",
  "version": "0.1.0",
  "description": "Cross-platform Obsidian plugin for automatic two-way sync with Google Drive",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "esbuild cli/oauth-setup.ts --bundle --platform=node --format=esm --outfile=dist/oauth-setup.mjs && node dist/oauth-setup.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "google-drive",
    "sync"
  ],
  "author": "prsantiago",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
